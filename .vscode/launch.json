{
    "version": "0.2.0",
    "configurations": [
        {
            // 烧录 + 调试 + RTT 日志
            // 按 F5 会先执行 preLaunchTask(build)，再烧录并停在 main
            "name": "OpenOCD: 烧录并调试 (RTT)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "servertype": "openocd",
            "serverpath": "openocd",
            "gdbPath": "arm-none-eabi-gdb",
            "objdumpPath": "arm-none-eabi-objdump",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "interface": "swd",
            "executable": "${workspaceFolder}/build/PYRo_Robot.elf",
            "runToEntryPoint": "main",
            "preLaunchTask": "build",
            "svdFile": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32F407.svd",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "rttConfig": {
                "enabled": true,
                // "auto" 表示从 ELF 里读取 _SEGGER_RTT 符号地址，
                // 不需要手动写 0x20000000 和搜索范围
                "address": "auto",
                "searchId": "SEGGER RTT",
                "polling_interval": 10,
                "rtt_start_retry": 2000,
                "decoders": [
                    {
                        "label": "RTT Terminal",
                        "port": 0,
                        "type": "console",
                        "timestamp": false,
                        "inputmode": "disabled"
                    }
                ]
            }
        },
        {
            // 只烧录，不进入调试（不占断点、不打断运行）
            "name": "OpenOCD: 仅烧录并运行",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "servertype": "openocd",
            "serverpath": "openocd",
            "gdbPath": "arm-none-eabi-gdb",
            "objdumpPath": "arm-none-eabi-objdump",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "interface": "swd",
            "executable": "${workspaceFolder}/build/PYRo_Robot.elf",
            "preLaunchTask": "build",
            "openOCDLaunchCommands": [
                "program ${workspaceFolder}/build/PYRo_Robot.elf verify reset"
            ],
            "runToEntryPoint": "main"
        },
        {
            // 板子已经在跑，只附加调试 + RTT，不重新烧录
            "name": "OpenOCD: 附加 (不烧录, RTT)",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "servertype": "openocd",
            "serverpath": "openocd",
            "gdbPath": "arm-none-eabi-gdb",
            "objdumpPath": "arm-none-eabi-objdump",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "interface": "swd",
            "executable": "${workspaceFolder}/build/PYRo_Robot.elf",
            "svdFile": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32F407.svd",
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "searchId": "SEGGER RTT",
                "polling_interval": 10,
                "rtt_start_retry": 2000,
                "decoders": [
                    {
                        "label": "RTT Terminal",
                        "port": 0,
                        "type": "console",
                        "timestamp": false,
                        "inputmode": "disabled"
                    }
                ]
            }
        }
    ]
}
